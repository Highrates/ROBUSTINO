# SEO / SPA shell — fragment for robustino.ru
# Apply alongside existing /api and /media locations.
#
# BEFORE nginx:
#   # never `source` the API .env (breaks bcrypt $2a$…)
#   bash /root/robustino/scripts/deploy-api.sh
#   # ensure SPA_DIST=/var/www/html in /root/robustino-api/.env
#   curl -sI http://127.0.0.1:4000/ | head -5   # SEO shell when SPA_DIST set
#
# Apply:
#   bash /root/robustino/scripts/patch-nginx-seo.sh
#   curl -sA 'YandexBot/3.0' https://robustino.ru/products | grep -E 'title|canonical|seo-content'
#
# Env on API (.env):
#   SITE_PUBLIC_URL=https://robustino.ru
#   SPA_DIST=/var/www/html
#   SEO_CACHE_DIR=/var/www/html/seo-cache

# --- Option A (recommended): assets on disk, HTML documents via API ---
# Insert BEFORE catch-all `location /` in EVERY server{} (http + https).

location = /sitemap.xml {
    proxy_pass http://127.0.0.1:4000/api/seo/sitemap.xml;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location = /feed.yml {
    proxy_pass http://127.0.0.1:4000/api/seo/feed.yml;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location = /robots.txt {
    root /var/www/html;
    try_files /robots.txt =404;
}

# Homepage SEO shell
location = / {
    proxy_pass http://127.0.0.1:4000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Accept $http_accept;
}

# Catalog / about / blog list / projects / upholstery
location ~ ^/(products|about|articles|projects|upholstery)/?$ {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Accept $http_accept;
}

# Product / article / FAQ page cards
location ~ ^/(product|article|page)/ {
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Accept $http_accept;
}

# Catch-all remains for /assets, /admin, /media is separate:
# location / {
#     root /var/www/html;
#     try_files $uri $uri/ /index.html;
# }
# or proxy to pm2 `serve`

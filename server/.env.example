# Copy to server/.env on VPS (do not commit secrets)
PORT=4000
NODE_ENV=production
DATABASE_URL=postgres://robustino:CHANGE_ME@127.0.0.1:5433/robustino

# Required: min 16 chars. Process will not start without it.
JWT_SECRET=change-me-long-random-secret
# Session TTL (httpOnly cookie). Examples: 4h, 8h, 12h
JWT_EXPIRES=8h
COOKIE_MAX_AGE_SEC=28800
COOKIE_NAME=robustino_session
COOKIE_SECURE=true

ADMIN_EMAIL=admin@robustino.ru
# Required: bcrypt hash only (not plaintext). Generate:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD=$2a$12$replaceWithRealBcryptHash

MEDIA_ROOT=/var/www/html/media
MEDIA_PUBLIC_BASE=https://robustino.ru/media

# --- Site chat (guest cookie ↔ admin) ---
# Guest session cookie (httpOnly). Defaults match shared/siteChatLimits.js
CHAT_COOKIE_NAME=robustino_chat
CHAT_COOKIE_MAX_AGE_SEC=31536000
# CHAT_GUEST_UPLOAD_MAX_BYTES=8388608
# CHAT_ADMIN_UPLOAD_MAX_BYTES=15728640
# CHAT_CONV_QUOTA_BYTES=41943040
# CHAT_ORPHAN_TTL_MS=3600000
# CHAT_EMPTY_CONV_TTL_MS=86400000

# Telegram notify (guest message → staff). Never commit the real token.
# Setup:
#   1) Token from @BotFather → TELEGRAM_BOT_TOKEN
#   2) Each recipient opens @Robustino_bot and presses Start
#   3) node server/scripts/print-telegram-chat-id.mjs → TELEGRAM_CHAT_ID=id1,id2
#   (or TELEGRAM_NOTIFY_USERNAME=Deni_Sazonov,Ramada10 to resolve from getUpdates)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_USERNAME=Deni_Sazonov,Ramada10
# SITE_PUBLIC_URL=https://robustino.ru
# TELEGRAM_DEBOUNCE_MS=45000
# TELEGRAM_NOTIFY=1

CORS_ORIGIN=https://robustino.ru,http://localhost:3000,http://localhost:5173

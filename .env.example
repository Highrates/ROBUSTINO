# Supabase (self-hosted на своём сервере)
# Одна и та же БД для локальной разработки и продакшена.
# Скопируйте в .env и подставьте URL и ключ вашего инстанса.

# URL API вашего Supabase (например https://ваш-домен.ru/supabase-api или http://194.67.124.92/supabase-api)
VITE_SUPABASE_URL=
# Anon key из Supabase (Dashboard → Settings → API)
VITE_SUPABASE_ANON_KEY=

# Supabase Cloud — одна и та же БД для локальной разработки и продакшена.
# Скопируйте в .env и подставьте URL и ключ из Dashboard проекта.

# Project URL из Supabase Dashboard (Settings → API). Без слэша в конце.
# Пример: https://zopserojkbhrrrrkllhr.supabase.co
VITE_SUPABASE_URL=
# anon public key из Supabase Dashboard (Settings → API)
VITE_SUPABASE_ANON_KEY=
